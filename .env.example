# Twilio (optional — SMS to owner when client submits contact form)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_PHONE=+1XXXXXXXXXX
TO_PHONE=+13133789982

# Server deployment
NODE_ENV=production
# Comma-separated origins. Keep localhost entries for local testing if needed.
CORS_ORIGINS=https://fleet.swordfishconsultingin.com,https://www.swordfishconsultingin.com,https://swordfishconsultingin.com,http://localhost:5173

# Firebase (optional — enables real-time data; app runs in demo mode without these)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
